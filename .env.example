# DualSPHysics MCP server configuration (environment variables only).
#
# Every variable is optional: unset tools are looked up on PATH and in a few
# conventional install locations (see check_environment for the report).
# Copy this file to `.env` (gitignored) or export the variables in the
# mcpServers config of your MCP client (see examples/mcp_config.example.json).

# Absolute path to the GenCase pre-processor binary.
# Example: /home/<user>/softwares/DualSPHysics/bin/linux/GenCase_linux64
#DSPH_GENCASE=

# Absolute path to the CPU solver binary (name carries the version, e.g.
# DualSPHysics5.4CPU_linux64). The directory holding the solver is prepended
# to LD_LIBRARY_PATH automatically (libChronoEngine.so and friends live there).
# Example: /home/<user>/softwares/DualSPHysics/bin/linux/DualSPHysics5.4CPU_linux64
#DSPH_SOLVER=

# Absolute path to the PartVTK post-processor binary.
# Example: /home/<user>/softwares/DualSPHysics/bin/linux/PartVTK_linux64
#DSPH_PARTVTK=

# Absolute path to the MeasureTool post-processor binary.
# Example: /home/<user>/softwares/DualSPHysics/bin/linux/MeasureTool_linux64
#DSPH_MEASURETOOL=

# Root directory where run_case creates job directories (status.json, Run.out,
# data/Part_*.bi4). Default: ./jobs relative to the working directory of the
# server process. Gitignored.
#DSPH_JOBS_DIR=./jobs

# OpenMP threads for the CPU solver (-ompthreads). Default: all logical cores.
#DSPH_OMP_THREADS=8
